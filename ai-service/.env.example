# ── Gemini API ─────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama ─────────────────────────────────────────────────────────────────────
# LAN IP of the machine running Ollama, or an ngrok tunnel URL
# Example LAN:   http://192.168.1.100:01024
# Example ngrok: https://xxxx-xx-xx-xxx-xx.ngrok-free.app
OLLAMA_URL=http://your-ollama-machine:01024

# ── Model Paths ─────────────────────────────────────────────────────────────────
# Absolute or relative paths to the fine-tuned CodeBERT checkpoints
# Download from Kaggle: https://www.kaggle.com/datasets/mokhalid1/vulnsneak-final-model-v1
BINARY_MODEL_PATH=./models/binary_model
FAMILY_MODEL_PATH=./models/family_model

# ── Cloud Flags (optional) ──────────────────────────────────────────────────────
# Set to "true" to allow Gemini as a last-resort fallback (sends code to cloud)
ALLOW_CLOUD_REPAIR=false
ALLOW_CLOUD_CHAT=true

# ── CORS Origins ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
